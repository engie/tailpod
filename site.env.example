# Required — core platform (always needed)
SSH_PUBKEY="ssh-ed25519 YOUR_PUBLIC_KEY_HERE you@example.com"
QUADSYNC_GIT_URL=git@github.com:your-org/containers.git
QUADSYNC_GIT_BRANCH=main

# Optional — Tailscale networking (only needed when using tailscale.bu)
TS_API_CLIENT_ID=your-oauth-client-id
TS_API_CLIENT_SECRET=your-oauth-client-secret
TAILNET_DOMAIN=your-tailnet.ts.net

# Optional — host node on the tailnet (only needed when using host-tailscale.bu).
# Requires a SEPARATE OAuth client scoped to tag:host only — Tailscale OAuth
# requires every minted key to carry all tags listed in the client's scope, so
# tailmint's tag:tailpod client cannot mint single-tagged tag:host keys.
TS_HOST_API_CLIENT_ID=your-host-oauth-client-id
TS_HOST_API_CLIENT_SECRET=your-host-oauth-client-secret
TS_HOST_HOSTNAME=tailpod-fcos-test

# Optional — registry auth (only needed when using registry.bu)
REGISTRY_AUTH_B64=base64-encoded-user:token

# Optional — secrets decryption (only needed when container repo has SOPS-encrypted files)
QUADSYNC_AGE_KEY=AGE-SECRET-KEY-your-age-private-key

# Optional — storage layer (only needed when using server.bu)
# Attached block volume holding /data (live SQLite) and /blobs, mounted at
# /var/mnt/storage. Use a stable /dev/disk/by-id path.
STORAGE_VOLUME_DEVICE=/dev/disk/by-id/scsi-0HC_Volume_XXXXXXXXX
# Cloudflare R2 (S3-compatible) bucket for litestream backups. OBJECT_BUCKET is
# the full https://<account>.r2.cloudflarestorage.com/<bucket> URL; the build
# tool splits it into endpoint + bucket name.
OBJECT_BUCKET=https://<account>.r2.cloudflarestorage.com/your-bucket
OBJECT_KEY=your-r2-access-key-id
OBJECT_SECRET=your-r2-secret-access-key
# restic client-side encryption password for blob backups (generate a strong
# random value, e.g. `openssl rand -base64 30`). Losing this means losing the
# ability to decrypt the blob backups — keep it safe.
BLOBS_RESTIC_PASSWORD=your-restic-encryption-password
