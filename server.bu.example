variant: fcos
version: 1.6.0

storage:
  directories:
    - path: /var/mnt/storage

  files:
    # Constrain zincati's auto-updates to a weekly window so a freshly-imaged
    # host doesn't immediately chain-reboot through pending ostree updates and
    # interrupt the first quadsync run. The cost is OS updates lag up to a
    # week; refresh the FCOS snapshot periodically to keep that lag bounded.
    - path: /etc/zincati/config.d/55-periodic-updates.toml
      mode: 0644
      contents:
        inline: |
          [updates]
          strategy = "periodic"

          [[updates.periodic.window]]
          days = ["Sat"]
          start_time = "02:00"
          length_minutes = 240

    # Base transform — storage additions (appended to _base.container from tailpod.bu)
    # The build tool concatenates same-path file contents across overlays.
    # Both /data (live SQLite) and /blobs live on the attached block volume
    # mounted at /var/mnt/storage. SELinux is handled by a mount-wide context=
    # (see the mount unit below), so the bind mounts deliberately use no :z/:Z
    # relabel flag — per-file relabel (lsetxattr) fails for pod members, whose
    # root-owned dirs can't be relabelled by the rootless pod user.
    - path: /etc/quadsync/transforms/_base.container
      mode: 0644
      contents:
        inline: |
          [Unit]
          After=var-mnt-storage.mount
          Requires=var-mnt-storage.mount
          Requires={{.Name}}-litestream.service
          After={{.Name}}-litestream.service

          [Service]
          +ExecStartPre=sudo /usr/local/bin/storage-init %N

          [Container]
          +Volume=/var/mnt/storage/{{.Name}}/data:/data
          +Volume=/var/mnt/storage/{{.Name}}/blobs:/blobs

    # Base pod transform — applied to all .pod files
    - path: /etc/quadsync/transforms/_base.pod
      mode: 0644
      contents:
        inline: |
          [Pod]

    # Litestream sidecar companion template — replicates the live SQLite db on
    # the block volume to a Cloudflare R2 (S3) bucket. The litestream image is
    # scratch-based (no shell), so restore and replicate run as separate steps:
    # restore as ExecStartPre via a one-shot podman run, then the main container
    # runs replicate via the image's default litestream entrypoint.
    - path: /etc/quadsync/transforms/_base-litestream.container
      mode: 0644
      contents:
        inline: |
          # quadsync:no-pod — litestream backs up to S3/R2 over the public
          # internet, so it must keep default networking (host DNS). Without
          # this, pod members' sidecars inherit the pod's tailnet netns and
          # MagicDNS can't resolve the S3 endpoint.
          [Unit]
          After=var-mnt-storage.mount
          Requires=var-mnt-storage.mount

          [Container]
          Image=docker.io/litestream/litestream:latest
          Exec=replicate
          # Litestream's hardened image runs as USER nonroot (uid 65532), which
          # in rootless podman maps outside the per-tenant user's id range and
          # cannot create WAL/shm files in the shared /data volume (SQLite
          # errors with SQLITE_READONLY_DIRECTORY, code 1544). Run as in-userns
          # root so we share an identity with the app container's default user.
          User=0:0
          Volume=/var/mnt/storage/{{.Name}}/data:/data
          Volume=/etc/litestream.yml:/etc/litestream.yml:ro
          EnvironmentFile=/etc/litestream.env
          Environment=LITESTREAM_PATH={{.Name}}

          [Service]
          ExecStartPre=sudo /usr/local/bin/storage-init {{.Name}}
          ExecStartPre=/usr/bin/podman run --rm \
            --volume /var/mnt/storage/{{.Name}}/data:/data \
            --volume /etc/litestream.yml:/etc/litestream.yml:ro \
            --env-file /etc/litestream.env \
            --env LITESTREAM_PATH={{.Name}} \
            docker.io/litestream/litestream:latest \
            restore -if-db-not-exists -if-replica-exists /data/db.sqlite
          Restart=always
          RestartSec=10s

          [Install]
          WantedBy=default.target

    # Litestream config — shared by all sidecar containers. Site-specific S3
    # endpoint, bucket and credentials come from /etc/litestream.env; the
    # per-container replica path comes from LITESTREAM_PATH. Litestream expands
    # ${VAR} references in this file from its environment at runtime.
    - path: /etc/litestream.yml
      mode: 0644
      contents:
        inline: |
          dbs:
            - path: /data/db.sqlite
              replicas:
                - type: s3
                  endpoint: ${LITESTREAM_ENDPOINT}
                  bucket: ${LITESTREAM_BUCKET}
                  path: ${LITESTREAM_PATH}
                  region: auto
                  force-path-style: true

    # Litestream S3 (Cloudflare R2) credentials + endpoint, shared by all
    # sidecars. Readable by container users (cusers group) so rootless podman
    # can pass it via --env-file. LITESTREAM_ACCESS_KEY_ID/SECRET_ACCESS_KEY are
    # litestream's recognised credential env vars.
    - path: /etc/litestream.env
      mode: 0640
      user:
        name: root
      group:
        name: cusers
      contents:
        inline: |
          LITESTREAM_ACCESS_KEY_ID=${OBJECT_KEY}
          LITESTREAM_SECRET_ACCESS_KEY=${OBJECT_SECRET}
          LITESTREAM_ENDPOINT=${OBJECT_ENDPOINT}
          LITESTREAM_BUCKET=${OBJECT_BUCKET_NAME}

    # Storage init script — creates per-container dirs on the block volume.
    # Note: no shell variables consumed by envsubst — the build tool only
    # substitutes ${VAR} for allowlisted keys, and none appear here.
    - path: /usr/local/bin/storage-init
      mode: 0755
      contents:
        inline: |
          #!/bin/bash
          set -euo pipefail
          if [[ -z "${1-}" ]]; then
            echo "storage-init: missing container name argument" >&2
            exit 1
          fi
          NAME="$(basename "$1")"
          if [[ ! "$NAME" =~ ^[a-z0-9][a-z0-9_-]{0,62}$ ]]; then
            echo "storage-init: invalid container name: $NAME" >&2
            exit 1
          fi
          base="/var/mnt/storage/$NAME"
          mkdir -p "$base/data" "$base/blobs" "$base/certs"
          # ext4 supports POSIX ownership. For a standalone container the Linux
          # user is named after the container, and the container's in-userns
          # root maps to that user's uid — so chown the tree to the user and
          # rootless podman can read/write the bind mounts. Pod members share
          # the pod's user (no user matches the member name); fall back to
          # world-writable dirs so the shared user can still create files.
          if id "$NAME" >/dev/null 2>&1; then
            chown -R "$NAME:$NAME" "$base"
          else
            chmod 0777 "$base/data" "$base/blobs" "$base/certs"
          fi

    # Allow managed container users to run storage-init as root
    # Sudoers glob: [a-z] prefix + alphanumeric/hyphen/underscore only
    - path: /etc/sudoers.d/storage-init
      mode: 0440
      contents:
        inline: |
          %cusers ALL=(root) NOPASSWD: /usr/local/bin/storage-init [a-z][a-z0-9_-]*

systemd:
  units:
    # Mount the attached block volume (ext4) at /var/mnt/storage. The volume is
    # provisioned/formatted out of band and persists across host reimages, so
    # ignition only mounts it here — it never formats it.
    - name: var-mnt-storage.mount
      enabled: true
      contents: |
        [Unit]
        Description=Mount block storage volume
        After=local-fs-pre.target
        Before=local-fs.target

        [Mount]
        What=${STORAGE_VOLUME_DEVICE}
        Where=/var/mnt/storage
        Type=ext4
        # context= applies one SELinux label to the whole mount so confined
        # containers (container_t) can access bind mounts without a per-file
        # :z/:Z relabel. Per-file relabel (lsetxattr) fails for pod members
        # whose root-owned dirs can't be relabelled by the rootless pod user,
        # so we label mount-wide instead. DAC ownership is still handled by
        # storage-init (chown for standalone containers, 0777 for pod members).
        Options=defaults,nofail,x-systemd.device-timeout=30s,context=system_u:object_r:container_file_t:s0

        [Install]
        WantedBy=local-fs.target
