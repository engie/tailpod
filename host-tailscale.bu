variant: fcos
version: 1.6.0

storage:
  directories:
    # Persistent state for host tailscaled (separate from containers' tsnet state)
    - path: /var/lib/tailscale
      mode: 0700
    # Holding directory for the downloaded tarball before extraction
    - path: /var/lib/tailscale-install
      mode: 0755

  files:
    # Tailscale static binary tarball — fetched + hash-verified by ignition.
    # The host-tailscale-install.service one-shot extracts tailscale + tailscaled
    # into /usr/local/{bin,sbin} on first boot, then removes the tarball.
    - path: /var/lib/tailscale-install/tailscale.tgz
      mode: 0644
      contents:
        source: https://pkgs.tailscale.com/stable/tailscale_1.98.2_arm64.tgz
        # Tailscale periodically re-rolls the stable tarball for a given version,
        # which changes the bytes/hash while keeping the version string. A stale
        # hash makes Ignition abort first boot (emergency mode, no sshd). Re-pinned
        # 2026-06-18 to the then-current artifact (verified: valid 1.98.2 package).
        verification:
          hash: sha256-2941071f5b33d2c3be4072853a765d2d0252fee8589b298e54ca4d36fbe82094

    # Host-side OAuth credentials — a SEPARATE OAuth client from tailmint's.
    # Tailscale's OAuth model requires that all tags listed in an
    # auth_keys-write scope be present on every minted key. tailmint's client
    # is scoped to tag:tailpod; this client is scoped to tag:host. They can't
    # share a client without forcing every node into the union of both tags.
    # The OAuth client secret embeds its own client ID (tskey-client-<id>-<secret>),
    # so the daemon accepts it directly as --auth-key.
    # Required OAuth scopes:
    #   - auth_keys (tag:host)  : mint the up token
    #   - devices:core          : delete stale nodes pre-flight (avoids -N hostname suffix)
    - path: /etc/tailscale/host-oauth.env
      mode: 0600
      contents:
        inline: |
          TS_AUTH_SECRET=${TS_HOST_API_CLIENT_SECRET}
          TS_HOST_HOSTNAME=${TS_HOST_HOSTNAME}

    # Up script (registers the host, pre-flight deletes stale devices to avoid
    # -N hostname suffixing). See scripts/tailscale-up for details.
    - path: /usr/local/sbin/tailscale-up
      mode: 0755
      contents:
        local: scripts/tailscale-up

    # Recovery script (wipe state + re-register), invoked by the watchdog.
    - path: /usr/local/sbin/tailscale-recover
      mode: 0755
      contents:
        local: scripts/tailscale-recover

systemd:
  units:
    # Extract the tailscale tarball into /usr/local on first boot.
    # ConditionPathExists guards against re-extraction on subsequent boots.
    - name: host-tailscale-install.service
      enabled: true
      contents: |
        [Unit]
        Description=Install tailscale static binaries
        ConditionPathExists=!/usr/local/sbin/tailscaled
        After=network-online.target
        Before=tailscaled.service

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/bin/tar -xzf /var/lib/tailscale-install/tailscale.tgz -C /var/lib/tailscale-install --strip-components=1
        ExecStart=/usr/bin/install -m 0755 /var/lib/tailscale-install/tailscale  /usr/local/bin/tailscale
        ExecStart=/usr/bin/install -m 0755 /var/lib/tailscale-install/tailscaled /usr/local/sbin/tailscaled
        ExecStart=/usr/bin/rm -rf /var/lib/tailscale-install

        [Install]
        WantedBy=multi-user.target

    # tailscaled daemon — runs as root, manages /var/lib/tailscale state.
    # Port 41641 is the default Tailscale WireGuard port.
    - name: tailscaled.service
      enabled: true
      contents: |
        [Unit]
        Description=Tailscale node agent
        Documentation=https://tailscale.com/kb/
        Wants=network-pre.target
        After=network-pre.target NetworkManager.service systemd-resolved.service
        After=host-tailscale-install.service
        Requires=host-tailscale-install.service

        [Service]
        ExecStartPre=/usr/local/sbin/tailscaled --cleanup
        ExecStart=/usr/local/sbin/tailscaled --state=/var/lib/tailscale/tailscaled.state --socket=/run/tailscale/tailscaled.sock --port=41641
        ExecStopPost=/usr/local/sbin/tailscaled --cleanup
        Restart=on-failure
        RestartSec=5s
        RuntimeDirectory=tailscale
        RuntimeDirectoryMode=0755
        StateDirectory=tailscale
        StateDirectoryMode=0700
        CacheDirectory=tailscale
        CacheDirectoryMode=0750
        Type=notify

        [Install]
        WantedBy=multi-user.target

    # One-shot tailscale up — runs once, registers the node, enables SSH.
    - name: tailscale-up.service
      enabled: true
      contents: |
        [Unit]
        Description=Register host on the tailnet (one-shot)
        After=tailscaled.service network-online.target
        Wants=network-online.target
        Requires=tailscaled.service
        ConditionPathExists=!/var/lib/tailscale/.up-done

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/local/sbin/tailscale-up

        [Install]
        WantedBy=multi-user.target

    # Watchdog: detect when the node has been deleted from the tailnet
    # (tailscaled loops on "PollNetMap: initial fetch failed 404: node not
    # found") and trigger recovery. Triggered by the timer below.
    - name: host-tailscale-watchdog.service
      contents: |
        [Unit]
        Description=Detect and recover from a deleted tailnet node
        After=tailscaled.service
        Requires=tailscaled.service

        [Service]
        Type=oneshot
        ExecStart=/bin/bash -c 'if journalctl -u tailscaled --since "6 minutes ago" | grep -q "node not found"; then /usr/local/sbin/tailscale-recover; fi'

    - name: host-tailscale-watchdog.timer
      enabled: true
      contents: |
        [Unit]
        Description=Periodic check for deleted tailnet node

        [Timer]
        OnBootSec=5min
        OnUnitActiveSec=5min

        [Install]
        WantedBy=timers.target
